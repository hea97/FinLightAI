APP_ENV=local
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=sqlite:///./data/finlightai.db

# Google OAuth. For production, use:
# GOOGLE_REDIRECT_URI=https://<render-production-domain>/api/auth/google/callback
# FRONTEND_URL=https://<vercel-production-domain>
# BACKEND_URL=https://<render-production-domain>
# CORS_ORIGINS=https://<vercel-production-domain>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Exhibition-only demo login fallback. Disabled by default.
# demo@finlightai.local is a placeholder identity, not a real email recipient.
EXHIBITION_DEMO_LOGIN_ENABLED=false
EXHIBITION_DEMO_ACCESS_CODE=
EXHIBITION_DEMO_EMAIL=demo@finlightai.local
EXHIBITION_DEMO_NAME=FinLightAI Demo

# Auth/session secrets. Replace before any shared or deployed environment.
JWT_SECRET_KEY=change-me-local-jwt-secret
NOTIFICATION_SECRET=change-me-local-notification-job-secret
NOTIFICATION_TOKEN_SECRET=change-me-local-notification-token-secret

# Email provider
# MVP default: Resend. SMTP remains available by setting EMAIL_PROVIDER=smtp
# and filling SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD.
EMAIL_PROVIDER=resend
SMTP_FROM=FinLightAI <alerts@your-verified-domain.example>
RESEND_API_KEY=re_replace_me
EMAIL_WEBHOOK_SECRET=whsec_replace_me

# SMTP alternative
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional provider/API keys
GEMINI_API_KEY=
NEWS_API_KEY=
GUARDIAN_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
OPENAI_API_KEY=
OPENDART_API_KEY=

# Kakao/n8n placeholders. Kakao delivery is disabled until approved.
KAKAO_CHANNEL_ID=
KAKAO_CHANNEL_APPROVED=false
N8N_KAKAO_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
