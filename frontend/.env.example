VITE_API_BASE_URL=https://<render-production-domain>
# Display-only flag for the exhibition CTA. Backend EXHIBITION_DEMO_LOGIN_ENABLED is the real gate.
VITE_EXHIBITION_DEMO_LOGIN_ENABLED=true
# Explicit exhibition-only sample data mode.
# Never treat this data as live market/API data.
VITE_EXHIBITION_DEMO_MODE=false
